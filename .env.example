# Copy to .env locally; on Render set these in Dashboard > Environment.
# NEVER commit the real .env file.

PORT=8000
NODE_ENV=production

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/serverfy?retryWrites=true&w=majority
MONGODB_DB=serverfy

# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:8080,https://serverfy.in,https://www.serverfy.in

# Secret used to sign admin login sessions (long random string)
JWT_SECRET=change-me-to-a-long-random-string

# First (owner) admin, created automatically on first boot only.
# All other admins are created from inside the dashboard by the owner.
OWNER_NAME=ServerFY Owner
OWNER_EMAIL=owner@serverfy.in
OWNER_PASSWORD=a-strong-password-min-10-chars
